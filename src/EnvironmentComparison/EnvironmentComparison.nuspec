<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>EnvironmentComparison.XrmToolBox</id>
    <version>$version$</version>
    <title>Environment Comparison for XrmToolBox</title>
    <authors>Ross King</authors>
    <owners>Ross King</owners>
    <projectUrl>https://github.com/rlking1985/environment-comparison</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/rlking1985/environment-comparison/dev/src/EnvironmentComparison/assets/icon.png</iconUrl>
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Read-only comparison of Dataverse tables, columns, forms, system views, and organization SSRS reports between two environments. Highlights missing components and important definition differences while excluding managed-versus-unmanaged noise.</description>
    <summary>Compare important Dataverse metadata safely between environments.</summary>
    <releaseNotes>Uses a stable public PNG logo URL for XrmToolBox portal validation. The table logical-name regex remains empty by default.</releaseNotes>
    <copyright>Copyright © 2026 Ross King</copyright>
    <tags>XrmToolBox Plugins Dataverse Dynamics365 Metadata Tables Columns Reports SSRS Comparison</tags>
    <dependencies>
      <dependency id="XrmToolBox" version="1.2025.10.74" />
    </dependencies>
  </metadata>
  <files>
    <file src="bin\$configuration$\net48\EnvironmentComparison.dll" target="lib\net48\Plugins" />
    <file src="assets\icon.png" target="" />
    <file src="README.package.md" target="README.md" />
    <file src="..\..\LICENSE" target="LICENSE" />
  </files>
</package>
