<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>EnvironmentComparison.XrmToolBox</id>
    <version>$version$</version>
    <title>Environment Comparison for XrmToolBox</title>
    <authors>Ross King</authors>
    <owners>Ross King</owners>
    <projectUrl>https://github.com/rlking1985/environment-comparison</projectUrl>
    <iconUrl>https://api.nuget.org/v3-flatcontainer/environmentcomparison.xrmtoolbox/$version$/icon</iconUrl>
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Read-only comparison of Dataverse table, column, form, and system-view metadata between two environments. Highlights missing components and important definition differences while excluding managed-versus-unmanaged noise.</description>
    <summary>Compare important Dataverse metadata safely between environments.</summary>
    <releaseNotes>Form security roles are compared semantically: standard roles use stable RoleTemplateId values, other roles use ParentRootRoleId when available, and unresolved roles retain their original IDs. Raw role IDs remain available in the diagnostic export. Removes the Custom table and Custom component columns from the grid and CSV exports.</releaseNotes>
    <copyright>Copyright © 2026 Ross King</copyright>
    <tags>XrmToolBox Plugins Dataverse Dynamics365 Metadata Tables Columns Comparison</tags>
    <dependencies>
      <dependency id="XrmToolBox" version="1.2025.10.74" />
    </dependencies>
  </metadata>
  <files>
    <file src="bin\$configuration$\net48\EnvironmentComparison.dll" target="lib\net48\Plugins" />
    <file src="assets\icon.png" target="" />
    <file src="README.package.md" target="README.md" />
    <file src="..\..\LICENSE" target="LICENSE" />
  </files>
</package>
